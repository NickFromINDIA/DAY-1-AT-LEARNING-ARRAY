#include <stdio.h>
int main(){
    int arr[100],a;
    printf("pleeasee enter the size of the array:");
    scanf("%d",&a);
    printf("Now enter the elements of the array:");
    for(int i=0;i<a;i++){
        scanf("%d",&arr[i]);
    }
    printf("array after insertions of %d values:\n",a);
    for(int i=0;i<a;i++){
        printf("%d,",arr[i]);
    }
    printf("\n");
    int nothing;
    for(int i=0;i<a;i++){
        for(int j=0;j<a;j++){
            if(arr[j]>arr[j+1]){
                nothing=arr[j];
                arr[j]=arr[j+1];
                arr[j+1]=nothing;
            }
        }
    }
    printf("Aray after the complete ascending process:");
    for(int i=0;i<a;i++){
        printf("%d,",arr[i]);
    }
}
