#include <stdio.h>
int main(){
    int a;
    printf("Enter the size of the array:");
    scanf("%d",&a);
      int arr[a+1];
    for(int i = 0;i<a;i++)
    {
        printf("Please enter your %d element:\n",i+1);
        scanf("%d",&arr[i]);
    }
    printf("Array after insertion:\n");
    for(int i=0;i<a;i++){
        printf("%d\n",arr[i]);
    }
    int pos;
    int val;
    printf("Enter the position you want to add anyother element(1-%d)",a);
    scanf("%d",&pos);
    printf("Now enter the value you want to store:");
    scanf("%d",&val);
    for(int i=a;i>=pos;i--){
        arr[i+1]=arr[i];
    }
    arr[pos]=val;
        printf("Array again after new element insertion:\n");
    for(int i=0;i<=a;i++){
        printf("%d\n",arr[i]);
    }
  
    int posi;
    printf("Enter the position you want to delete a value from:");
    scanf("%d",&posi);
     printf("Array before Deletion:\n");
    for(int i=0;i<=a;i++){
        printf("%d\n",arr[i]);
    }
    for(int i=posi;i<=a;i++){
         arr[i] = arr[i+1];
    }
    
     printf("Array after Deletion:\n");
    for(int i=0;i<a;i++){
        printf("%d\n",arr[i]);
    }
    
}
